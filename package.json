{
  "name": "@maguirekrist/stack-config",
  "version": "1.11.0",
  "description": "The shared lint setup and coding standards for Foldkit, Effect and Alchemy Domain projects.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maguirekrist/stack-config.git"
  },
  "packageManager": "pnpm@12.18.0",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "README.md",
    "CODING_STANDARDS.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.js",
    "check": "prettier --check . && tsc && git diff --exit-code dist && node --test test/*.test.js"
  },
  "peerDependencies": {
    "@effect/tsgo": "^0.69.0",
    "@foldkit/oxlint-plugin": "^0.15.4",
    "oxlint": "^1.93.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "26.6.6",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
